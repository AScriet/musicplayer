<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Light theme ===== -->
    <style name="Theme.Auxio.Light" parent="Theme.Auxio.Base">
        <!-- Primary -->
        <item name="colorPrimary">@color/neutral</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/neutral_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorPrimaryInverse">@color/white</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/neutral_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/neutral</item>

        <item name="colorTertiary">@color/neutral_light</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/white</item>
        <item name="colorOnTertiaryContainer">@color/neutral</item>
        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/white</item>
        <item name="colorOnErrorContainer">@color/error_dark_container</item>
        <!-- Background and surfaces -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/surface_dark_1</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/surface_dark_1</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/neutral</item>
        <item name="colorSurfaceInverse">@color/neutral_dark</item>

    </style>

    <!-- ===== Dark theme ===== -->
    <style name="Theme.Auxio.Dark" parent="Theme.Auxio.Light">
        <!-- Platform text colors, used by views that don't read colorOnSurface -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/neutral_variant_light</item>
        <item name="android:textColorTertiary">@color/neutral_variant_light</item>
        <!-- Primary -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/surface_dark_1</item>
        <item name="colorPrimaryContainer">@color/neutral_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorPrimaryInverse">@color/neutral</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/neutral_dark</item>
        <item name="colorSecondaryContainer">@color/neutral</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <!-- Background and surfaces -->
        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/neutral</item>
        <item name="colorOnSurfaceVariant">@color/neutral_variant_light</item>
        <item name="colorSurfaceInverse">@color/white</item>
        <item name="colorOnSurfaceInverse">@color/neutral_dark</item>
        <item name="colorSurfaceContainerLow">@color/surface_dark_1</item>
        <item name="colorSurfaceContainer">@color/surface_dark_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_dark_1</item>
        <item name="colorSurfaceContainerHighest">@color/surface_dark_1</item>
    </style>
</resources>